<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style
        name="Theme.Music"
        parent="Theme.AppCompat.DayNight.NoActionBar">

        <item name="android:windowBackground">#101010</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>

    </style>

    <style name="Theme.Xios.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#080B0D</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Music</item>
    </style>
</resources>